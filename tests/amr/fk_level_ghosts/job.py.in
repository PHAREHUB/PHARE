#!/usr/bin/env python3
# fully kinetic, 2D, 16^2 root cells in 8^2 patches, one refined box of 8^2 root cells: the fine
# level is 16^2 fine cells in 4 patches of 8^2, whose corners and shared edges touch the level
# boundary. Drifting plasma, so that the current is not zero; cleaning on, so that rho is deposited.

import numpy as np

import pyphare.pharein as ph

ph.Simulation(
    time_step=0.002,
    time_step_nbr=1,
    cells=(16, 16),
    dl=(0.04, 0.04),
    interp_order=@INTERP_ORDER@,
    model_options=["FullyKineticModel"],
    c_over_va=10.0,
    divergence_cleaning=0.5,
    smallest_patch_size=8,
    largest_patch_size=8,
    refinement_boxes={"L0": {"B0": [(4, 4), (11, 11)]}},
)


def uniform(value):
    return lambda x, y: value + 0.0 * x


def species(charge, mass, temperature, drift):
    vth = uniform(np.sqrt(temperature / mass))
    return {
        "charge": charge,
        "mass": mass,
        "density": uniform(1.0),
        "vbulkx": uniform(drift),
        "vbulky": uniform(-0.5 * drift),
        "vbulkz": uniform(0.0),
        "vthx": vth,
        "vthy": vth,
        "vthz": vth,
        "nbr_part_per_cell": 4,
        "init": {"seed": 1},
    }


ph.MaxwellianFluidModel(
    bx=uniform(1.0),
    by=uniform(0.0),
    bz=uniform(0.0),
    protons=species(1, 1.0, 0.01, 0.3),
    electrons=species(-1, 0.04, 0.03, -0.6),
)
