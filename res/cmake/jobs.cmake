function(phare_cgroup_limit_mb file out_var)
  set(${out_var} "" PARENT_SCOPE)
  if(NOT EXISTS "${file}")
    return()
  endif()
  file(READ "${file}" content)
  string(STRIP "${content}" content)
  if("${content}" MATCHES "^[0-9]+$")
    math(EXPR limit_mb "${content} / 1048576")
    set(${out_var} "${limit_mb}" PARENT_SCOPE)
  endif()
endfunction()

function(phare_cgroup_memory_mb proc_cgroup_file cgroup_root out_var)
  string(REGEX REPLACE "/+$" "" cgroup_root "${cgroup_root}")
  set(limits "")
  if(EXISTS "${proc_cgroup_file}")
    file(STRINGS "${proc_cgroup_file}" lines)
    foreach(line IN LISTS lines)
      set(base "")
      if("${line}" MATCHES "^0::(/.*)$")
        set(base "${cgroup_root}")
        set(limit_file "memory.max")
        set(path "${CMAKE_MATCH_1}")
      elseif("${line}" MATCHES "^[0-9]+:([^:]*):(/.*)$")
        set(path "${CMAKE_MATCH_2}")
        string(REPLACE "," ";" controllers "${CMAKE_MATCH_1}")
        if("memory" IN_LIST controllers)
          set(base "${cgroup_root}/memory")
          set(limit_file "memory.limit_in_bytes")
        endif()
      endif()
      if("${base}" STREQUAL "" OR "${path}" MATCHES "/\\.\\.(/|$)")
        continue()
      endif()
      string(LENGTH "${base}" base_length)
      string(REGEX REPLACE "/+$" "" dir "${base}${path}")
      while(TRUE)
        phare_cgroup_limit_mb("${dir}/${limit_file}" limit)
        if(NOT "${limit}" STREQUAL "")
          list(APPEND limits ${limit})
        endif()
        string(LENGTH "${dir}" dir_length)
        if(NOT dir_length GREATER base_length)
          break()
        endif()
        get_filename_component(dir "${dir}" DIRECTORY)
      endwhile()
    endforeach()
  endif()
  foreach(root_file "${cgroup_root}/memory.max" "${cgroup_root}/memory/memory.limit_in_bytes")
    phare_cgroup_limit_mb("${root_file}" limit)
    if(NOT "${limit}" STREQUAL "")
      list(APPEND limits ${limit})
    endif()
  endforeach()
  set(memory_mb "")
  foreach(limit IN LISTS limits)
    if("${memory_mb}" STREQUAL "" OR limit LESS memory_mb)
      set(memory_mb ${limit})
    endif()
  endforeach()
  set(${out_var} "${memory_mb}" PARENT_SCOPE)
endfunction()

function(phare_effective_memory_mb total_mb cgroup_mb out_var)
  set(memory_mb ${total_mb})
  if(NOT "${cgroup_mb}" STREQUAL "" AND cgroup_mb LESS memory_mb)
    set(memory_mb ${cgroup_mb})
  endif()
  set(${out_var} ${memory_mb} PARENT_SCOPE)
endfunction()

function(phare_module_compile_jobs total_mb cgroup_mb per_module_mb out_var)
  phare_effective_memory_mb(${total_mb} "${cgroup_mb}" memory_mb)
  math(EXPR jobs "${memory_mb} * 3 / 4 / ${per_module_mb}")
  if(jobs LESS 1)
    set(jobs 1)
  endif()
  set(${out_var} ${jobs} PARENT_SCOPE)
endfunction()

function(phare_effective_module_jobs explicit memory_mb per_module_mb out_var)
  if(NOT "${per_module_mb}" MATCHES "^[0-9]+$" OR per_module_mb EQUAL 0)
    message(FATAL_ERROR
      "PHARE_MODULE_COMPILE_MEMORY_MB must be a positive integer (MiB), got '${per_module_mb}'")
  endif()
  if("${explicit}" STREQUAL "")
    phare_module_compile_jobs(${memory_mb} "" ${per_module_mb} jobs)
  elseif("${explicit}" MATCHES "^[0-9]+$")
    math(EXPR jobs "${explicit}")
  else()
    message(FATAL_ERROR
      "PHARE_MODULE_COMPILE_JOBS must be empty (sized from memory), 0 (no limit) or a positive integer, got '${explicit}'")
  endif()
  set(${out_var} ${jobs} PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
  return()
endif()

cmake_host_system_information(RESULT PHARE_HOST_MEMORY_MB QUERY TOTAL_PHYSICAL_MEMORY)
phare_cgroup_memory_mb("/proc/self/cgroup" "/sys/fs/cgroup" PHARE_CGROUP_MEMORY_MB)
phare_effective_memory_mb(${PHARE_HOST_MEMORY_MB} "${PHARE_CGROUP_MEMORY_MB}" PHARE_MEMORY_MB)

set(PHARE_MODULE_COMPILE_MEMORY_MB "2048" CACHE STRING "Peak memory in MiB of one simulator module compile or link")
set(PHARE_MODULE_COMPILE_JOBS "" CACHE STRING "Maximum concurrent simulator module compiles and links: empty sizes it from memory, 0 disables the limit")
phare_effective_module_jobs(
  "${PHARE_MODULE_COMPILE_JOBS}" ${PHARE_MEMORY_MB} "${PHARE_MODULE_COMPILE_MEMORY_MB}" PHARE_MODULE_JOBS)

if(PHARE_MODULE_JOBS EQUAL 0)
  message(STATUS "PHARE module compiles and links: no limit (PHARE_MODULE_COMPILE_JOBS=0, ${PHARE_MEMORY_MB} MiB available)")
elseif(NOT "${PHARE_MODULE_COMPILE_JOBS}" STREQUAL "")
  message(STATUS "PHARE module compiles and links: at most ${PHARE_MODULE_JOBS} at once (PHARE_MODULE_COMPILE_JOBS, ${PHARE_MEMORY_MB} MiB available)")
else()
  message(STATUS "PHARE module compiles and links: at most ${PHARE_MODULE_JOBS} at once (3/4 of ${PHARE_MEMORY_MB} MiB available, ${PHARE_MODULE_COMPILE_MEMORY_MB} MiB each)")
endif()

if(CMAKE_GENERATOR MATCHES "Ninja" AND PHARE_MODULE_JOBS GREATER 0)
  set_property(GLOBAL APPEND PROPERTY JOB_POOLS phare_modules=${PHARE_MODULE_JOBS})
endif()

function(phare_limit_module_compile target)
  if(NOT PHARE_MODULE_JOBS GREATER 0)
    return()
  endif()
  if(CMAKE_GENERATOR MATCHES "Ninja")
    set_property(TARGET ${target} PROPERTY JOB_POOL_COMPILE phare_modules)
    set_property(TARGET ${target} PROPERTY JOB_POOL_LINK phare_modules)
  elseif(CMAKE_GENERATOR MATCHES "Makefiles")
    set(slot
      ${Python_EXECUTABLE}
      ${PHARE_PROJECT_DIR}/res/cmake/compile_slot.py
      ${PHARE_MODULE_JOBS}
      ${CMAKE_BINARY_DIR}/.phare_compile_slots)
    set(launcher ${slot})
    if(CMAKE_CXX_COMPILER_LAUNCHER)
      list(APPEND launcher ${CMAKE_CXX_COMPILER_LAUNCHER})
    endif()
    set_property(TARGET ${target} PROPERTY CXX_COMPILER_LAUNCHER "${launcher}")
    set(link_launcher "")
    foreach(arg IN LISTS slot)
      string(APPEND link_launcher " \"${arg}\"")
    endforeach()
    string(STRIP "${link_launcher}" link_launcher)
    set_property(TARGET ${target} PROPERTY RULE_LAUNCH_LINK "${link_launcher}")
  endif()
endfunction()
