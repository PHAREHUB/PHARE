# include-what-you-use mappings, used by the iwyu mkn profiles and -DwithIWYU=ON (res/cmake/iwyu.cmake)
# third party headers come <...> through -isystem (CMake) and "..." through -I (mkn), so
# both spellings are mapped, each to its public header spelled the same way
[
  # prefer the C++ headers: <cassert> over <assert.h>, <cstdlib> over <stdlib.h>. iwyu's own
  # mappings already mark the C headers public, so they can't be remapped by include, only by
  # symbol
  { symbol: ["assert", "private", "<cassert>", "public"] },
  { symbol: ["abort", "private", "<cstdlib>", "public"] },
  { symbol: ["exit", "private", "<cstdlib>", "public"] },
  { symbol: ["getenv", "private", "<cstdlib>", "public"] },
  { symbol: ["std::abs", "private", "<cstdlib>", "public"] },
  # libstdc++ <format> forward declares vector, iwyu can pick it for vector users
  { symbol: ["std::vector", "private", "<vector>", "public"] },

  # MPI only through PHARE's wrapper, which silences warnings around it
  { include: ["<mpi.h>", "private", "\"phare_mpi.hpp\"", "public"] },
  { include: ["\"mpi.h\"", "private", "\"phare_mpi.hpp\"", "public"] },

  # generated by the configurator, only through the headers that include them if they exist
  { include: ["\"core/def/_gen_sys.hpp\"", "private", "\"core/def/phare_config.hpp\"", "public"] },
  { include: ["\"core/def/_gen_mpi.hpp\"", "private", "\"phare_mpi.hpp\"", "public"] },

  # phlop only through PHARE's wrapper, which makes it optional (__has_include)
  { include: ["@<phlop/.*>", "private", "\"core/def/phlop.hpp\"", "public"] },
  { include: ["@\"phlop/.*\"", "private", "\"core/def/phlop.hpp\"", "public"] },

  # HighFive: each bits/ header is included by its public H5*.hpp, highfive.hpp includes them all
  { include: ["@<highfive/bits/.*>", "private", "<highfive/highfive.hpp>", "public"] },
  { include: ["@\"highfive/bits/.*\"", "private", "\"highfive/highfive.hpp\"", "public"] },
  { include: ["@<highfive/h5easy_bits/.*>", "private", "<highfive/H5Easy.hpp>", "public"] },
  { include: ["@\"highfive/h5easy_bits/.*\"", "private", "\"highfive/H5Easy.hpp\"", "public"] },
  # HighFive's own headers include each other without the highfive/ prefix
  { include: ["\"H5Attribute.hpp\"", "private", "\"highfive/H5Attribute.hpp\"", "public"] },
  { include: ["\"H5DataSet.hpp\"", "private", "\"highfive/H5DataSet.hpp\"", "public"] },
  { include: ["\"H5DataSpace.hpp\"", "private", "\"highfive/H5DataSpace.hpp\"", "public"] },
  { include: ["\"H5DataType.hpp\"", "private", "\"highfive/H5DataType.hpp\"", "public"] },
  { include: ["\"H5Easy.hpp\"", "private", "\"highfive/H5Easy.hpp\"", "public"] },
  { include: ["\"H5Exception.hpp\"", "private", "\"highfive/H5Exception.hpp\"", "public"] },
  { include: ["\"H5File.hpp\"", "private", "\"highfive/H5File.hpp\"", "public"] },
  { include: ["\"H5Group.hpp\"", "private", "\"highfive/H5Group.hpp\"", "public"] },
  { include: ["\"H5Object.hpp\"", "private", "\"highfive/H5Object.hpp\"", "public"] },
  { include: ["\"H5PropertyList.hpp\"", "private", "\"highfive/H5PropertyList.hpp\"", "public"] },
  { include: ["\"H5Reference.hpp\"", "private", "\"highfive/H5Reference.hpp\"", "public"] },
  { include: ["\"H5Selection.hpp\"", "private", "\"highfive/H5Selection.hpp\"", "public"] },
  { include: ["\"H5Utility.hpp\"", "private", "\"highfive/H5Utility.hpp\"", "public"] },
  { include: ["\"H5Version.hpp\"", "private", "\"highfive/H5Version.hpp\"", "public"] },

  # pybind11: pybind11.h is the public entry for the core API
  { include: ["@<pybind11/(detail/.*|(attr|buffer_info|cast|gil|gil_safe_call_once|options|pytypes|trampoline_self_life_support|typing)\\.h)>", "private", "<pybind11/pybind11.h>", "public"] },
  { include: ["@\"pybind11/(detail/.*|(attr|buffer_info|cast|gil|gil_safe_call_once|options|pytypes|trampoline_self_life_support|typing)\\.h)\"", "private", "\"pybind11/pybind11.h\"", "public"] },
  # pybind11's relative includes of its own detail/ headers
  { include: ["@\"detail/.*\"", "private", "<pybind11/pybind11.h>", "public"] },

  # CPython: the headers Python.h includes (python3.13), others like datetime.h stay public
  { include: ["@[<\"]cpython/.*[>\"]", "private", "<Python.h>", "public"] },
  { include: ["@[<\"](abstract|bltinmodule|boolobject|bytearrayobject|bytesobject|ceval|codecs|compile|complexobject|critical_section|descrobject|dictobject|enumobject|exports|fileobject|fileutils|floatobject|genericaliasobject|import|intrcheck|iterobject|listobject|lock|longobject|memoryobject|methodobject|modsupport|moduleobject|monitoring|object|objimpl|osmodule|patchlevel|pyatomic|pybuffer|pycapsule|pyconfig|pyerrors|pyframe|pyhash|pylifecycle|pymacconfig|pymacro|pymath|pymem|pyport|pystate|pystats|pystrcmp|pystrtod|pythonrun|pythread|pytypedefs|rangeobject|setobject|sliceobject|structseq|sysmodule|traceback|tupleobject|typeslots|unicodeobject|warnings|weakrefobject)\\.h[>\"]", "private", "<Python.h>", "public"] },
]
